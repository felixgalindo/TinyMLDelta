<mxfile host="app.diagrams.net" type="device">
  <diagram name="Patch Apply Flow" id="tmd-apply">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="tmd_apply_patch_from_memory(patch, len)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="parse" value="Parse header + TLVs&#10;(version, algo, lengths, guardrail metadata)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;" vertex="1" parent="1">
          <mxGeometry x="200" y="90" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="guard" value="Guardrails / envelope check&#10;arena ≤ firmware · opset ⊆ linked · I/O compatible" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="180" y="170" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rejectG" value="return ERR_GUARDRAIL&#10;(active slot untouched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="copy" value="Copy active slot A → inactive slot B&#10;(stream through 1 KB window)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="200" y="300" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="For each chunk: verify CRC32 → decode (RAW/RLE) → flash_write to slot B → journal next index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="160" y="380" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="crc" value="CRC mismatch?&#10;→ return ERR_INTEGRITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;" vertex="1" parent="1">
          <mxGeometry x="560" y="385" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="verify" value="Verify slot B == target digest" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="flip" value="Clear journal · atomic flip: B becomes active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="200" y="580" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="return OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#15803d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="660" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="powerloss" value="Power loss any time before flip → reboot: journal resumes from next_chunk_idx; slot A still valid" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="620" height="40" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="a1" style="endArrow=block;html=1;" edge="1" parent="1" source="start" target="parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;" edge="1" parent="1" source="parse" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" value="fail" style="endArrow=block;html=1;strokeColor=#dc2626;" edge="1" parent="1" source="guard" target="rejectG"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="pass" style="endArrow=block;html=1;" edge="1" parent="1" source="guard" target="copy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="endArrow=block;html=1;" edge="1" parent="1" source="copy" target="loop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="endArrow=block;html=1;strokeColor=#dc2626;" edge="1" parent="1" source="loop" target="crc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="endArrow=block;html=1;" edge="1" parent="1" source="loop" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" value="ok" style="endArrow=block;html=1;" edge="1" parent="1" source="verify" target="flip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a9" style="endArrow=block;html=1;" edge="1" parent="1" source="flip" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

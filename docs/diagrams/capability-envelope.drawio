        <mxCell id="out" value="Outside the envelope — new operator type · arena/slot overflow · I/O the sensor can't supply → requires a firmware OTA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="690" height="44" as="geometry"/></mxCell>


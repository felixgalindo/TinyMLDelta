        <mxCell id="l3" value="Slot sized for largest model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="250" height="36" as="geometry"/></mxCell>
